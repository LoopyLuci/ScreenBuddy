# Git ignore for ScreenBuddy

# Rust
/target/
**/target/
Cargo.lock
**/*.rs.bk
*.pdb

# Godot
toolkit/godot-project/.godot/
toolkit/godot-project/*.import/

# Godot engine binaries are third-party downloads (~127 MB combined) and exceed
# GitHub's 100 MB per-file limit. They are not tracked. See README "Toolkit"
# for how to fetch them; godot-harness.sh also honours the GODOT_BIN env var.
/toolkit/bin/*.exe
/toolkit/bin/Godot_*

# Android build output
ScreenBuddy-Android/local.properties
ScreenBuddy-Android/keystore.properties
ScreenBuddy-Android/.gradle/
**/build/
*.apk
*.aab
*.keystore
*.jks

# Staged release artifacts (attached to GitHub Releases, not committed)
/dist/

# Python
__pycache__/
*.py[cod]
.venv/

# Exports (keep directory)
exports/.gitkeep

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary
*.tmp
*.bak
