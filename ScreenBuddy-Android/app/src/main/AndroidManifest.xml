<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Launch on boot" toggle in Settings. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Posting notifications is a runtime permission from Android 13, so it has to
      be declared as well as requested. Without this the notifications setting
      cannot do anything on a modern device.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11 / API 30+): without these, the platform
      reports zero TTS engines and TextToSpeech fails to initialise, so
      speech never works. TTS is looked up by intent action.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenBuddy"
        android:name=".ScreenBuddyApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenBuddy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Control surface for agents, mirroring the desktop's TCP control port.
          Exported so `adb shell am broadcast` can drive the app; every command is
          validated in ControlCommands and unknown ones are rejected, and no
          privileged action is reachable through it.
        -->
        <receiver
            android:name=".receiver.ControlReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.screenbuddy.android.CONTROL" />
            </intent-filter>
        </receiver>

        <!--
          Makes the "Launch on boot" setting real: the permission was declared
          with no receiver, so the toggle did nothing. Not exported beyond the
          system broadcast it listens for, and it restores state rather than
          stealing focus at boot.
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
